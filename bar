#!/usr/bin/env bash

set -e

AUR_RPC_URL="https://aur.archlinux.org/rpc/?v=5&type="
AUR_GIT_URL="https://aur.archlinux.org"
BUILD_DIR="/tmp/bar-builds"

mkdir -p "$BUILD_DIR"

print_usage() {
    echo "Usage:"
    echo "  bar -S <pkg1> [pkg2 ...] : Install packages (Repo or AUR)"
    echo "  bar -Ss <query>          : Search and install interactively"
    echo "  bar -Syu                 : Update system and AUR packages"
    echo "  bar -Sc                  : Clean up local AUR build cache"
    exit 1
}

aur_search() {
    local query="$1"
    echo -e "\033[1;34m::\033[0m Searching official repos..."
    pacman -Ss "$query" || true
    
    echo -e "\n\033[1;34m::\033[0m Searching AUR..."
    if ! command -v jq &> /dev/null; then
        echo "Error: 'jq' is required for AUR search."
        exit 1
    fi

    local response
    response=$(curl -s "${AUR_RPC_URL}search&arg=${query}")
    
    local mapfile_output
    IFS=$'\n' read -r -d '' -a mapfile_output < <(echo "$response" | jq -r '.results[] | "\(.Name)|:\(.Version)|:\(.Description)"' && printf '\0' ) || true

    if [ ${#mapfile_output[@]} -eq 0 ]; then
        echo "No AUR matches found."
        return
    fi

    local count=1
    for item in "${mapfile_output[@]}"; do
        local name=$(echo "$item" | cut -d'|' -f1)
        local ver=$(echo "$item" | cut -d'|' -f2 | sed 's/^://')
        local desc=$(echo "$item" | cut -d'|' -f3 | sed 's/^://')
        echo -e "\033[1;35m$count\033[0m \033[1;32maur/$name\033[0m \033[1;33m$ver\033[0m\n    $desc"
        count=$((count + 1))
    done

    echo -e "\n\033[1;33m=>\033[0m Enter numbers to install (separated by spaces, e.g., 1 3 5), or press Enter to exit:"
    read -r -a choices

    if [ ${#choices[@]} -eq 0 ]; then
        return
    fi

    local selected_pkgs=()
    for choice in "${choices[@]}"; do
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#mapfile_output[@]} ]; then
            local index=$((choice - 1))
            local target_name=$(echo "${mapfile_output[$index]}" | cut -d'|' -f1)
            selected_pkgs+=("$target_name")
        fi
    done

    if [ ${#selected_pkgs[@]} -gt 0 ]; then
        aur_install "${selected_pkgs[@]}"
    fi
}

aur_install() {
    local packages=("$@")
    
    for pkg in "${packages[@]}"; do
        if pacman -Si "$pkg" &>/dev/null; then
            echo -e "\n\033[1;34m::\033[0m Found '$pkg' in official repositories. Installing via pacman..."
            sudo pacman -S "$pkg"
            continue
        fi

        local target_dir="${BUILD_DIR}/${pkg}"
        echo -e "\n\033[1;34m::\033[0m Processing AUR package: \033[1;32m$pkg\033[0m"
        
        if [ -d "$target_dir" ]; then
            rm -rf "$target_dir"
        fi

        if ! git clone "${AUR_GIT_URL}/${pkg}.git" "$target_dir" &>/dev/null; then
            echo -e "\033[1;31mError:\033[0m '$pkg' not found in repos or AUR."
            exit 1
        fi

        local start_dir=$(pwd)
        cd "$target_dir"

        echo -e "\033[1;33m=>\033[0m Review PKGBUILD for $pkg? [Y/n]"
        read -r answer
        if [[ "$answer" =~ ^[Yy]$ ]] || [ -z "$answer" ]; then
            ${PAGER:-less} PKGBUILD
        fi

        echo -e "\033[1;34m::\033[0m Running makepkg..."
        makepkg -sic

        cd "$start_dir"
    done
}

sys_update() {
    echo -e "\033[1;34m::\033[0m Synchronizing repository databases and updating system..."
    sudo pacman -Syu

    echo -e "\n\033[1;34m::\033[0m Checking AUR for updates..."
    if ! command -v jq &> /dev/null; then
        echo "Error: 'jq' is required to check AUR updates."
        exit 1
    fi

    local foreign_pkgs=$(pacman -Qm | awk '{print $1}')
    if [ -z "$foreign_pkgs" ]; then
        echo "No AUR packages installed."
        return
    fi

    local query_args=""
    for p in $foreign_pkgs; do
        query_args="${query_args}&arg[]=${p}"
    done

    local response=$(curl -s "${AUR_RPC_URL}info${query_args}")
    local needs_update=()

    for pkg in $foreign_pkgs; do
        local local_ver=$(pacman -Q "$pkg" | awk '{print $2}')
        local remote_ver=$(echo "$response" | jq -r ".results[] | select(.Name==\"$pkg\") | .Version")

        if [ -n "$remote_ver" ] && [ "$local_ver" != "$remote_ver" ]; then
            if [ "$(vercmp "$local_ver" "$remote_ver")" -lt 0 ]; then
                echo -e "\033[1;32m${pkg}\033[0m: ${local_ver} -> \033[1;33m${remote_ver}\033[0m"
                needs_update+=("$pkg")
            fi
        fi
    done

    if [ ${#needs_update[@]} -eq 0 ]; then
        echo "AUR packages are up to date."
    else
        echo -e "\n\033[1;34m::\033[0m Starting AUR upgrade..."
        aur_install "${needs_update[@]}"
    fi
}

clean_cache() {
    echo -e "\033[1;34m::\033[0m Found AUR build cache directory: $BUILD_DIR"
    local size=$(du -sh "$BUILD_DIR" 2>/dev/null | awk '{print $1}')
    echo -e "\033[1;34m::\033[0m Current cache size: \033[1;33m${size:-0B}\033[0m"
    echo -e "\033[1;33m=>\033[0m Do you want to remove all files in the build directory? [y/N]"
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        rm -rf "${BUILD_DIR:?}"/*
        echo -e "\033[1;32m::\033[0m Cache cleared successfully."
    else
        echo "Operation cancelled."
    fi
}

if [ $# -lt 1 ]; then
    print_usage
fi

case "$1" in
    -Ss)
        if [ -z "$2" ]; then print_usage; fi
        aur_search "$2"
        ;;
    -S)
        if [ -z "$2" ]; then print_usage; fi
        aur_install "${@:2}"
        ;;
    -Syu)
        sys_update
        ;;
    -Sc)
        clean_cache
        ;;
    *)
        print_usage
        ;;
esac
